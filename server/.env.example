# Copy this file to .env and adjust as needed.

# XAMPP's MySQL defaults: host localhost, port 3306, user root, empty password.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=poloprompt

# Port the API itself listens on.
PORT=3000

# The origin allowed to call this API. For local testing with the site's static
# server (assets/../serve.ps1 style setup) this is usually http://localhost:8080.
# In production, set this to https://poloprompt.com
CORS_ORIGIN=http://localhost:8080
