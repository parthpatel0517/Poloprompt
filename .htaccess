# PoloPrompt — Apache config for shared hosting / cPanel

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

# Force non-www (remove this block and swap to force-www if you prefer www.poloprompt.com)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301,NE]

# Clean URLs — /library instead of /library.html.
# 1) index.html always redirects to the site root.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html[\ ?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# 2) Any other direct *.html request 301-redirects to its extension-less form,
#    so search engines and links only ever see one canonical URL per page.
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.+)\.html[\ ?] [NC]
RewriteCond %{REQUEST_URI} !^/404\.html$
RewriteRule ^ /%1 [R=301,L]

# 2b) A trailing-slash request for a page that's also a folder name (e.g.
#     /blog/) redirects to the clean form without the slash.
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^ /%1 [R=301,L]

# 3) Internally serve the matching .html file for a clean URL, without
#    changing what's shown in the address bar. Deliberately NOT excluding
#    real directories here — /blog is both a page (blog.html) and a folder
#    (blog/ holding individual posts), and the page must win.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# Directory browsing off as defense-in-depth (Hostinger already blocks it by
# default, but this makes it explicit regardless of host).
Options -Indexes

# Custom error page
ErrorDocument 404 /404.html

# GZIP compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
